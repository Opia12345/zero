# --- Deriv ---
DERIV_APP_ID=
ACCOUNT=demo              # demo | real
LIVE_CONFIRM=no           # no = quote only (nothing is bought); yes = place trades
CURRENCY=USD

# --- Risk (per UTC day) ---
MAX_DAILY_LOSS=3          # stop for the day once down this many dollars
MAX_ATTEMPTS=4

# --- Strategy ---
FX_SYMBOLS=frxXAUUSD      # comma list, e.g. frxXAUUSD,frxEURUSD
FX_RISK=1.0               # dollars lost if the stop-loss hits (1R)
FX_RR=1.5                 # take-profit = RR x stop-loss
FX_MAX_STAKE=20

# --- Server ---
API_SECRET=               # protects /login and /dashboard

# --- Optional ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# On Render with a persistent disk mounted at /var/data:
# TOKENS_FILE=/var/data/deriv_tokens.json
# FX_LOG_FILE=/var/data/fx_trade_log.csv
